# Server Configuration
HOST=0.0.0.0
PORT=8080
ENVIRONMENT=development

# JWT Configuration (production refuses to start with the default secret)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Login: NetID allowlist + one shared team password.
# In development, leaving these unset allows NetID "dev" with password "hyperloop-dev".
# Setup and rotation steps: .claude/auth-setup.md in the hyperloop-gui repo.
ALLOWED_NETIDS=
ALLOWED_NETIDS_FILE=
# Single quotes keep the "$" characters of the bcrypt hash literal
TEAM_PASSWORD_HASH=''

# Failed-login limits per window
LOGIN_MAX_FAILURES_PER_NETID=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_FAILURE_WINDOW_SECONDS=300
# Set true only behind Caddy/Cloudflare when port 8080 is not publicly reachable
TRUST_PROXY_HEADERS=false

# Device tokens (hub authentication): hub-id:token pairs, comma separated
# In development, leaving these unset allows dev-token-rpi-bridge-01 / -02.
DEVICE_TOKENS=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:4173,http://localhost:5173,http://localhost:8080,https://gui.cornellhyperloop.com
